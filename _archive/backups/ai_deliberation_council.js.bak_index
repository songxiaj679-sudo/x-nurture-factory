    },
    "algorithmOptimizer": {
      "name": "AI ③ アルゴリズム＆投稿時間最適化官",
      "recommendedFormat": "two_tier_reply_link",
      "recommendedSlotName": "平日夜のゴールデンタイム",
      "recommendedTimeJst": "20:30",
      "reason": "過去データと2026年アルゴリズムに基づく最適時間と形式の根拠"
    },
