/**
 * 📚 他アカウントの成功事例・Xアルゴリズム高エンゲージメント事例データベース（合議制AIの共有ナレッジ）
 */
/**
 * Google Trends (RSS) から本日の急上昇ワードを取得する関数
 */
async function fetchTodayTrends() {
  try {
    const Parser = require("rss-parser");
    const parser = new Parser();
    const feed = await parser.parseURL("https://trends.google.com/trends/trendingsearches/daily/rss?geo=JP");
    if (feed && feed.items && feed.items.length > 0) {
      const trends = feed.items.slice(0, 5).map(i => i.title);
      return trends;
    }
  } catch(e) { console.warn("Trend fetch error:", e.message); }
  return ["AI活用", "働き方改革", "インボイス", "生成AI", "副業"]; // Fallback
}

