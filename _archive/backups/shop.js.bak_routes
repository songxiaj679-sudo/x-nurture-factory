app.get('/api/dashboard/poll', async (req, res) => {
  try {
    const user = await getCurrentUser(req);
    if (!user) return res.json({ ok: false });
    const accSnap = await db.collection('saas_accounts').where('ownerUserId', '==', user.userId).get();
    const histSnap = await db.collection('saas_history').where('ownerUserId', '==', user.userId).get();
    const pendingAcc = accSnap.docs.filter(d => d.data().role === '検証中' || !d.data().role || !d.data().username).length;
    const pendingDel = histSnap.docs.filter(d => d.data().deleteReq === true).length;
    res.json({ ok: true, pendingAcc, pendingDel, totalHist: histSnap.size });
  } catch (e) {
    res.json({ ok: false });
  }
});

// ============================================================================
// ⚡ 4. メイン運用画面 (/dashboard) — 最新BYOK自律マーケティングコックピット
// ============================================================================
app.get('/dashboard', async (req, res) => {
  try {
    const user = await getCurrentUser(req);
    if (!user) return res.redirect('/#login-box');

    const okMsg = String(req.query.ok || '').trim();
    const errMsg = String(req.query.err || '').trim();
    const userEmail = escHtmlSrv(user.email || 'user@veloxpostapp.com');
    const userPlan = escHtmlSrv(user.planName || user.planId || '無料プラン');

    res.send(`<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>VeloxPost Cloud ｜ 自律AIマーケティング コックピット</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700;800&family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', 'Noto Sans JP', sans-serif; background-color: #060914; color: #f8fafc; min-height: 100vh; }
    .glass-nav { background: rgba(6, 10, 23, 0.85); backdrop-filter: blur(16px); }
    .cockpit-card { background: #0c1224; border: 1px solid rgba(255, 255, 255, 0.09); border-radius: 20px; padding: 26px; box-shadow: 0 8px 32px rgba(0,0,0,0.4); margin-bottom: 24px; }
    .card-header { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 14px; }
    .card-num { width: 30px; height: 30px; background: #2563eb; color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 14px; flex-shrink: 0; }
    .card-title { font-size: 17px; font-weight: 800; color: #fff; }
    .inp-dark { width: 100%; background: #070b16; border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; padding: 12px 14px; color: #fff; font-size: 14px; margin-bottom: 14px; outline: none; transition: 0.2s; }
    .inp-dark:focus { border-color: #38bdf8; box-shadow: 0 0 0 2px rgba(56,189,248,0.25); }
    .plan-card { background: #080d1a; border: 2px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 18px 14px; text-align: center; cursor: pointer; transition: all 0.2s; position: relative; }
    .plan-card:hover { border-color: #38bdf8; }
    .plan-card.selected { border-color: #2563eb; background: rgba(37,99,235,0.1); }
    .plan-badge { position: absolute; top: -10px; right: 12px; background: #f59e0b; color: #000; font-size: 10px; font-weight: 900; padding: 2px 8px; border-radius: 999px; }
    .currency-pill { padding: 6px 14px; border-radius: 999px; font-size: 12px; font-weight: 800; cursor: pointer; border: 1.5px solid transparent; transition: all 0.2s; }
    .currency-pill.active { background: #2563eb; color: #fff; }
    .currency-pill.inactive { background: #131c35; color: #94a3b8; border-color: rgba(255,255,255,0.1); }
    .plan-pay-btn { display: block; margin-top: 12px; padding: 10px 14px; background: rgba(255, 255, 255, 0.08); border: 1.5px solid rgba(255, 255, 255, 0.18); border-radius: 8px; color: #fff; font-size: 12px; font-weight: 800; text-align: center; text-decoration: none; transition: 0.2s; }
    .plan-pay-btn:hover { background: rgba(59, 130, 246, 0.25); border-color: #38bdf8; color: #38bdf8; }
    .plan-pay-btn.primary { background: #2563eb; border-color: #3b82f6; color: #fff; box-shadow: 0 4px 14px rgba(37,99,235,0.4); }
    .plan-pay-btn.primary:hover { background: #1d4ed8; }
  </style>
</head>
<body class="selection:bg-sky-500 selection:text-white">
  <!-- Sticky Cockpit Nav -->
  <header class="sticky top-0 z-50 glass-nav border-b border-white/10">
    <div class="max-w-6xl mx-auto px-6 h-18 py-3.5 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-sky-400 to-blue-600 flex items-center justify-center text-white font-black text-base shadow-lg shadow-sky-500/30">
          V
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="font-black text-lg tracking-wider text-white">VELOX</span>
            <span class="text-[10px] font-mono font-bold px-1.5 py-0.5 rounded bg-sky-500/20 text-sky-400 border border-sky-400/30">AUTONOMOUS</span>
          </div>
          <span class="text-[10px] font-mono tracking-widest text-slate-400 uppercase block">VeloxPost Cloud Cockpit</span>
        </div>
      </a>

      <div class="flex items-center gap-3">
        <span class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 text-xs font-mono font-bold">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          ${userPlan}
        </span>
        <span class="px-3 py-1.5 rounded-xl bg-white/5 border border-white/10 text-xs font-mono text-slate-300 font-bold">
          👤 ${userEmail}
        </span>
        <a href="/auth/logout" class="px-3.5 py-1.5 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 border border-rose-500/30 text-rose-300 text-xs font-bold transition-all">
          ログアウト
        </a>
      </div>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    ${okMsg ? `<div class="mb-6 p-4 rounded-2xl bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 font-bold text-sm text-center">✅ ${escHtmlSrv(okMsg)}</div>` : ''}
    ${errMsg ? `<div class="mb-6 p-4 rounded-2xl bg-rose-500/20 border border-rose-500/40 text-rose-300 font-bold text-sm text-center">⚠️ ${escHtmlSrv(errMsg)}</div>` : ''}

    <!-- 1. 本アカウント 公式APIキーの接続 -->
    <div class="cockpit-card">
      <div class="card-header">
        <div class="card-num">1</div>
        <div>
          <div class="card-title">本アカウント 公式APIキーの接続（初回1回のみ・凍結リスク完全ゼロ）</div>
          <div class="text-xs text-slate-400 mt-0.5">X Developer Portal で発行した公式APIキー（v2）を入力します。Cookieやパスワードは一切保存しないため安全です。</div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold text-slate-300 mb-1.5">API Key (Consumer Key)</label>
          <input type="text" id="inpApiKey" placeholder="API Key" class="inp-dark">
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-300 mb-1.5">API Secret (Consumer Secret)</label>
          <input type="password" id="inpApiSecret" placeholder="API Secret" class="inp-dark">
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-300 mb-1.5">Access Token</label>
          <input type="text" id="inpAccessToken" placeholder="Access Token" class="inp-dark">
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-300 mb-1.5">Access Token Secret</label>
          <input type="password" id="inpAccessTokenSecret" placeholder="Access Token Secret" class="inp-dark">
        </div>
      </div>

      <button type="button" onclick="verifyKeys()" class="mt-1 px-6 py-3 rounded-xl bg-gradient-to-r from-sky-500 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white font-black text-xs sm:text-sm shadow-lg shadow-sky-500/30 transition-all">
        ⚡ 公式APIキーの有効性を即時テスト ＆ 保存
      </button>
      <div id="keyMsg" class="mt-3 text-xs font-bold p-3 rounded-xl" style="display:none;"></div>
    </div>

    <!-- 2. AI自律マーケティング ターゲットURL入力 -->
    <div class="cockpit-card">
      <div class="card-header">
        <div class="card-num">2</div>
        <div>
          <div class="card-title">AI自律マーケティング ターゲットURL入力</div>
          <div class="text-xs text-slate-400 mt-0.5">広報・集客したいWebサイト、サービス、アフィリエイトLPのURLを入力してください。AIが自動解析して投稿を生成します。</div>
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-300 mb-1.5">宣伝・広報対象のWebサイト / LPのURL</label>
        <input type="url" id="inpTargetUrl" placeholder="https://your-service.com/product" value="https://veloxpostapp.com" class="inp-dark">
      </div>

      <button type="button" onclick="launchAutopilot()" class="w-full py-4 rounded-xl bg-gradient-to-r from-emerald-500 via-teal-600 to-emerald-700 hover:from-emerald-400 hover:to-teal-500 text-white font-black text-sm shadow-xl shadow-emerald-500/30 transition-all">
        🤖 AI自律マーケティング ＆ サテライト神輿担ぎを開始する
      </button>
      <div id="launchMsg" class="mt-3 text-xs font-bold p-3 rounded-xl" style="display:none;"></div>
    </div>

    <!-- 3. プラン選択 ＆ Wise公式1-Click決済 -->
    <div class="cockpit-card" id="secPlans">
      <div class="card-header justify-between flex-wrap gap-3">
        <div class="flex items-center gap-3">
          <div class="card-num">3</div>
          <div>
            <div class="card-title">運用プラン選択 ＆ 公式オンライン決済 (Wiseビジネス連携)</div>
            <div class="text-xs text-slate-400 mt-0.5">クレジットカード・デビットカードまたは銀行振込に対応。入金は即時自動検知されます。</div>
          </div>
        </div>

        <div class="flex items-center gap-2 bg-[#080d1a] p-1.5 rounded-full border border-white/10">
          <button type="button" class="currency-pill active" id="btnCurJpy" onclick="switchCurrency('jpy')">🇯🇵 JPY (日本円)</button>
          <button type="button" class="currency-pill inactive" id="btnCurUsd" onclick="switchCurrency('usd')">🇺🇸 USD (米ドル)</button>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
        <!-- スターター -->
        <div class="plan-card" id="planBox_starter" onclick="selectPlan('starter', this)">
          <div class="text-xs font-mono font-bold text-slate-400 mb-1">🥉 スターター</div>
          <div id="price_starter" class="text-2xl font-black text-white font-mono mb-2">¥4,980<span class="text-xs text-slate-400 font-sans">/月</span></div>
          <div class="text-[11px] text-slate-400 leading-relaxed mb-3">1日1投稿 (月30本)<br>サテライト応援 5台 (いいね/RT)</div>
          <a id="btnPay_starter" href="https://wise.com/pay/r/kXYnWl-m6k8WVOY" target="_blank" onclick="handlePayClick('starter', event)" class="plan-pay-btn">
            💳 ¥4,980 で決済 ↗
          </a>
        </div>

        <!-- プロ運用 -->
        <div class="plan-card selected" id="planBox_pro" onclick="selectPlan('pro', this)">
          <div class="plan-badge">一番人気 ★</div>
          <div class="text-xs font-mono font-bold text-sky-400 mb-1">🥈 プロ運用</div>
          <div id="price_pro" class="text-2xl font-black text-sky-400 font-mono mb-2">¥9,800<span class="text-xs text-slate-400 font-sans">/月</span></div>
          <div class="text-[11px] text-slate-400 leading-relaxed mb-3">1日3投稿 (朝昼夜ゴールデンタイム)<br>サテライト応援 12台 ＋ 引用RT</div>
          <a id="btnPay_pro" href="https://wise.com/pay/r/V_tnc7azl63ng3w" target="_blank" onclick="handlePayClick('pro', event)" class="plan-pay-btn primary">
            💳 ¥9,800 で決済 ↗
          </a>
        </div>

        <!-- ビジネス -->
        <div class="plan-card" id="planBox_business" onclick="selectPlan('business', this)">
          <div class="text-xs font-mono font-bold text-purple-400 mb-1">🥇 ビジネス</div>
          <div id="price_business" class="text-2xl font-black text-purple-300 font-mono mb-2">¥19,800<span class="text-xs text-slate-400 font-sans">/月</span></div>
          <div class="text-[11px] text-slate-400 leading-relaxed mb-3">1日5投稿 (月150本・フルオート)<br>強力サテライト 25台 ＋ リプ営業</div>
          <a id="btnPay_business" href="https://wise.com/pay/r/HEO5qptIIPhwhVQ" target="_blank" onclick="handlePayClick('business', event)" class="plan-pay-btn">
            💳 ¥19,800 で決済 ↗
          </a>
        </div>
      </div>

      <div id="checkoutBox" class="p-4 rounded-xl bg-sky-500/10 border border-sky-500/20 flex flex-wrap items-center justify-between gap-3">
        <div>
          <div id="selectedPlanLabel" class="text-xs sm:text-sm font-bold text-sky-300">現在選択中: 🥈 プロ運用プラン (¥9,800 / 月)</div>
          <div class="text-xs text-slate-400 mt-0.5">💳 クレジットカード・デビットカード・銀行振込（Wise公式）対応。入金は即時自動検知されます。</div>
        </div>
        <a id="btnPayDirect" href="https://wise.com/pay/r/V_tnc7azl63ng3w" target="_blank" onclick="handlePayClick(currentPlan, event)" class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs sm:text-sm shadow-lg shadow-blue-500/30 transition-all">
          💳 選択中のプランを決済する ↗
        </a>
      </div>
      <div id="checkoutStatus" class="mt-3 text-xs font-bold p-3 rounded-xl" style="display:none;"></div>
    </div>

    <!-- 4. 稼働中のスケジュールジョブ -->
    <div class="cockpit-card">
      <div class="card-header justify-between flex-wrap gap-2">
        <div class="flex items-center gap-3">
          <div class="card-num">4</div>
          <div class="card-title">📅 AIが自動作成した投稿スケジュール ＆ 連動ツリー一覧</div>
        </div>
        <button type="button" onclick="loadJobs()" class="px-4 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/15 text-xs font-bold text-slate-300 transition-all">
          最新に更新
        </button>
      </div>

      <div id="jobsContainer">
        <p class="text-xs text-slate-400">まだ自律投稿がスケジュールされていません。「2. AI自律マーケティング」より開始してください。</p>
      </div>
    </div>

    <!-- 5. サテライト神輿担ぎステータス -->
    <div class="cockpit-card">
      <div class="card-header">
        <div class="card-num">5</div>
        <div>
          <div class="card-title">🚀 サテライト神輿担ぎ（自動ブースト）ステータス</div>
          <div class="text-xs text-slate-400 mt-0.5">本アカウントの投稿直後、クラウドサテライト群が一斉に「いいね」「RT」「引用RT」を行い、Xの推薦アルゴリズムを刺激します。</div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs font-mono">
        <div class="p-4 rounded-xl bg-[#080d1a] border border-white/10">
          <div class="text-slate-400 mb-1">サテライト待機群</div>
          <div class="text-xl font-black text-emerald-400">25 / 25 台</div>
          <div class="text-[11px] text-slate-500 mt-1">● READY TO BOOST</div>
        </div>
        <div class="p-4 rounded-xl bg-[#080d1a] border border-white/10">
          <div class="text-slate-400 mb-1">神輿担ぎアクション</div>
          <div class="text-xl font-black text-sky-400">Like + RT + Quote</div>
          <div class="text-[11px] text-slate-500 mt-1">● ALGORITHM OPTIMIZED</div>
        </div>
        <div class="p-4 rounded-xl bg-[#080d1a] border border-white/10">
          <div class="text-slate-400 mb-1">初速ブースト開始遅延</div>
          <div class="text-xl font-black text-purple-400">30 〜 90 秒</div>
          <div class="text-[11px] text-slate-500 mt-1">● NATURAL ENGAGEMENT</div>
        </div>
      </div>
    </div>
  </main>

  <script>
    let currentPlan = 'pro';
    let currentCurrency = 'jpy';
    let pollOrderTimer = null;

    const WISE_LINKS = {
      jpy: {
        starter: 'https://wise.com/pay/r/kXYnWl-m6k8WVOY',
        pro: 'https://wise.com/pay/r/V_tnc7azl63ng3w',
        business: 'https://wise.com/pay/r/HEO5qptIIPhwhVQ'
      },
      usd: {
        starter: 'https://wise.com/pay/r/1OUW9iJBEMfwiN4',
        pro: 'https://wise.com/pay/r/WQRO5dMpUa7145g',
        business: 'https://wise.com/pay/r/h1yv3kXIvvcbh08'
      }
    };

    const PLAN_NAMES = {
      starter: '🥉 スタータープラン',
      pro: '🥈 プロ運用プラン',
      business: '🥇 ビジネスプラン'
    };

    const PLAN_PRICES = {
      jpy: { starter: '¥4,980', pro: '¥9,800', business: '¥19,800' },
      usd: { starter: '$39', pro: '$79', business: '$179' }
    };

    function switchCurrency(cur) {
      currentCurrency = cur;
      document.getElementById('btnCurJpy').className = cur === 'jpy' ? 'currency-pill active' : 'currency-pill inactive';
      document.getElementById('btnCurUsd').className = cur === 'usd' ? 'currency-pill active' : 'currency-pill inactive';

      document.getElementById('price_starter').innerHTML = PLAN_PRICES[cur].starter + '<span class="text-xs text-slate-400 font-sans">/月</span>';
      document.getElementById('price_pro').innerHTML = PLAN_PRICES[cur].pro + '<span class="text-xs text-slate-400 font-sans">/月</span>';
      document.getElementById('price_business').innerHTML = PLAN_PRICES[cur].business + '<span class="text-xs text-slate-400 font-sans">/月</span>';

      updatePlanButtons();
    }

    function selectPlan(plan, el) {
      currentPlan = plan;
      document.querySelectorAll('.plan-card').forEach(b => b.classList.remove('selected'));
      if (el) el.classList.add('selected');
      updatePlanButtons();
    }

    function updatePlanButtons() {
      const url = WISE_LINKS[currentCurrency][currentPlan];
      const prices = {
        starter: currentCurrency === 'jpy' ? '¥4,980' : '$39',
        pro: currentCurrency === 'jpy' ? '¥9,800' : '$79',
        business: currentCurrency === 'jpy' ? '¥19,800' : '$179'
      };

      const btnS = document.getElementById('btnPay_starter');
      const btnP = document.getElementById('btnPay_pro');
      const btnB = document.getElementById('btnPay_business');
      const btnD = document.getElementById('btnPayDirect');

      if (btnS) { btnS.href = WISE_LINKS[currentCurrency].starter; btnS.innerText = '💳 ' + prices.starter + ' で決済 ↗'; }
      if (btnP) { btnP.href = WISE_LINKS[currentCurrency].pro; btnP.innerText = '💳 ' + prices.pro + ' で決済 ↗'; }
      if (btnB) { btnB.href = WISE_LINKS[currentCurrency].business; btnB.innerText = '💳 ' + prices.business + ' で決済 ↗'; }

      if (btnD) {
        btnD.href = url;
        document.getElementById('selectedPlanLabel').innerText = '現在選択中: ' + PLAN_NAMES[currentPlan] + ' (' + prices[currentPlan] + ' / 月)';
      }
    }

    async function handlePayClick(plan, ev) {
      const cur = currentCurrency;
      fetch('/api/hybrid/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ plan, currency: cur, userId: '${user.userId}' })
      }).then(r => r.json()).then(d => {
        if (d.ok && d.orderId) {
          const st = document.getElementById('checkoutStatus');
          if (st) {
            st.style.display = 'block';
            st.className = 'mt-3 text-xs font-bold p-3 rounded-xl bg-sky-500/20 border border-sky-500/40 text-sky-300';
            st.innerHTML = '⏳ <b>Wise決済ウィンドウを開きました。</b><br>入金が完了すると自動的に検知され、アカウント権限が即座に昇格します（注文ID: ' + d.orderId + '）';
          }
          if (pollOrderTimer) clearInterval(pollOrderTimer);
          pollOrderTimer = setInterval(async () => {
            try {
              const res = await fetch('/api/hybrid/check-order?orderId=' + d.orderId);
              const o = await res.json();
              if (o.paid) {
                clearInterval(pollOrderTimer);
                if (st) {
                  st.className = 'mt-3 text-xs font-bold p-3 rounded-xl bg-emerald-500/20 border border-emerald-500/40 text-emerald-300';
                  st.innerHTML = '🎉 <b>入金が確認されました！</b> ' + (PLAN_NAMES[o.plan] || '') + ' が即時有効化されました。';
                }
              }
            } catch (err) {}
          }, 8000);
        }
      }).catch(() => {});
    }

    async function verifyKeys() {
      const msg = document.getElementById('keyMsg');
      msg.style.display = 'block';
      msg.className = 'mt-3 text-xs font-bold p-3 rounded-xl bg-sky-500/20 border border-sky-500/40 text-sky-300';
      msg.innerText = '⏳ 公式APIキーを検証中...';

      const body = {
        userId: '${user.userId}',
        apiKey: document.getElementById('inpApiKey').value,
        apiSecret: document.getElementById('inpApiSecret').value,
        accessToken: document.getElementById('inpAccessToken').value,
        accessTokenSecret: document.getElementById('inpAccessTokenSecret').value
      };

      try {
        const res = await fetch('/api/hybrid/verify-keys', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        const j = await res.json();
        if (j.ok) {
          msg.className = 'mt-3 text-xs font-bold p-3 rounded-xl bg-emerald-500/20 border border-emerald-500/40 text-emerald-300';
          msg.innerHTML = j.message;
        } else {
          msg.className = 'mt-3 text-xs font-bold p-3 rounded-xl bg-rose-500/20 border border-rose-500/40 text-rose-300';
          msg.innerText = '❌ ' + j.error;
        }
      } catch (e) {
        msg.className = 'mt-3 text-xs font-bold p-3 rounded-xl bg-rose-500/20 border border-rose-500/40 text-rose-300';
        msg.innerText = '❌ 通信エラー: ' + e.message;
      }
    }

    async function launchAutopilot() {
      const msg = document.getElementById('launchMsg');
      msg.style.display = 'block';
      msg.className = 'mt-3 text-xs font-bold p-3 rounded-xl bg-sky-500/20 border border-sky-500/40 text-sky-300';
      msg.innerHTML = '🔍 <b>AIがURL先をスクレイピングし、市場・ペルソナ分析中...</b> (約10〜15秒かかります)';

      const body = {
        userId: '${user.userId}',
        targetUrl: document.getElementById('inpTargetUrl').value,
        plan: currentPlan
      };

      try {
        const res = await fetch('/api/autopilot/launch', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        const j = await res.json();
        if (j.ok) {
          msg.className = 'mt-3 text-xs font-bold p-3 rounded-xl bg-emerald-500/20 border border-emerald-500/40 text-emerald-300';
          msg.innerHTML = j.message + '<br><small class="text-slate-400">🎯 分析対象: ' + (j.marketAnalysis ? j.marketAnalysis.serviceName : '') + ' / ターゲット: ' + (j.marketAnalysis ? j.marketAnalysis.targetAudience : '') + '</small>';
          loadJobs();
        } else {
          msg.className = 'mt-3 text-xs font-bold p-3 rounded-xl bg-rose-500/20 border border-rose-500/40 text-rose-300';
          msg.innerText = '❌ ' + j.error;
        }
      } catch (e) {
        msg.className = 'mt-3 text-xs font-bold p-3 rounded-xl bg-rose-500/20 border border-rose-500/40 text-rose-300';
        msg.innerText = '❌ ' + e.message;
      }
    }

    function getFormatBadge(fmt, isThread, threadLen) {
      if (fmt === 'multi_thread_story' || (isThread && threadLen >= 3)) {
        return '<span class="px-2 py-0.5 rounded bg-purple-500/20 text-purple-300 font-bold text-[11px] mr-2">🧵 ' + (threadLen || '3-4') + '段スレッド</span>';
      }
      if (fmt === 'two_tier_reply_link' || (isThread && threadLen === 2)) {
        return '<span class="px-2 py-0.5 rounded bg-blue-500/20 text-blue-300 font-bold text-[11px] mr-2">💬 2段リプ誘導</span>';
      }
      if (fmt === 'single_empathy') {
        return '<span class="px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 font-bold text-[11px] mr-2">☕ 単発共感</span>';
      }
      return '<span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-bold text-[11px] mr-2">📌 単発ノウハウ</span>';
    }

    async function loadJobs() {
      const cont = document.getElementById('jobsContainer');
      if (!cont) return;
      try {
        const res = await fetch('/api/autopilot/jobs?userId=${user.userId}');
        const j = await res.json();
        if (j.ok && Array.isArray(j.jobs) && j.jobs.length > 0) {
          let html = '';
          j.jobs.forEach((job) => {
            const isDone = job.status === 'posted';
            const dateStr = job.scheduledAt ? new Date(job.scheduledAt._seconds ? job.scheduledAt._seconds * 1000 : job.scheduledAt).toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' }) : '';
            const tweets = Array.isArray(job.tweets) && job.tweets.length > 0 ? job.tweets : [job.text || ''];
            const badge = getFormatBadge(job.format, job.isThread, tweets.length);

            let tweetHtml = '<div class="text-xs sm:text-sm text-slate-200 leading-relaxed whitespace-pre-wrap mt-1">' + tweets[0] + '</div>';
            if (tweets.length > 1) {
              tweetHtml += '<details class="mt-2 text-xs text-slate-400 cursor-pointer">' +
                '<summary class="text-sky-400 font-bold">▼ 連動ツリーを表示（全' + tweets.length + '件）</summary>' +
                '<div class="mt-2 pl-3 border-l-2 border-sky-400 space-y-2">';
              for (let t = 1; t < tweets.length; t++) {
                tweetHtml += '<div class="text-slate-300 whitespace-pre-wrap bg-[#070b16] p-2.5 rounded-lg border border-white/10"><b>(' + (t + 1) + '/' + tweets.length + ')</b> ' + tweets[t] + '</div>';
              }
              tweetHtml += '</div></details>';
            }

            html += '<div class="p-4 rounded-xl bg-[#080d1a] border border-white/10 mb-3 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">' +
              '<div class="max-w-full sm:max-w-[75%]">' +
                '<div class="flex items-center mb-1">' +
                  badge +
                  '<span class="text-xs text-slate-400 font-bold font-mono">[' + (job.angle || '自動最適化') + '] ' + dateStr + '</span>' +
                '</div>' +
                tweetHtml +
              '</div>' +
              '<div class="shrink-0">' +
                (isDone
                  ? '<a href="' + (job.tweetUrl || '#') + '" target="_blank" class="px-3.5 py-1.5 rounded-lg bg-emerald-600 text-white text-xs font-bold hover:bg-emerald-500 transition-all">✅ 投稿済 ↗</a>'
                  : '<span class="px-3.5 py-1.5 rounded-lg bg-white/10 text-slate-400 text-xs font-bold">⏳ 待機中</span>'
                ) +
              '</div>' +
            '</div>';
          });
          cont.innerHTML = html;
        } else {
          cont.innerHTML = '<p class="text-xs text-slate-400">まだ自律投稿がスケジュールされていません。「2. AI自律マーケティング」より開始してください。</p>';
        }
      } catch (e) {}
    }

    setTimeout(() => { loadJobs(); }, 800);
  </script>
</body>
</html>`);
  } catch (e) {
    res.status(500).send('エラー: ' + e.message);
  }
});

app.get('/contract', (req, res) => res.redirect('/dashboard#secPlans'));

// ============================================================================
// 💎 5. 契約・プラン選択ページ (/contract) — 文字はみ出し完全修正 ＆ 銀行振込表記撤去
// ============================================================================
app.get('/contract', async (req, res) => {
  try {
    const cookies = parseCookies(req);
    const token = cookies.xcloud_sess;
    if (!token) return res.redirect('/');
    const uSnap = await db.collection('saas_users').where('sessionToken', '==', token).limit(1).get();
    if (uSnap.empty) return res.redirect('/');

    await loadSysConfig();
    let userDoc = uSnap.docs[0];
    let uRaw = userDoc.data();

    if (uRaw.kycStatus === 'pending' && uRaw.kycProvider === 'didit' && uRaw.kycSessionId && sysConfig.diditApiKey) {
      const dec = await httpsJsonRequest('verification.didit.me', '/v3/session/' + encodeURIComponent(uRaw.kycSessionId) + '/decision/', 'GET', null, {
        'x-api-key': sysConfig.diditApiKey
      });
      const st = String((dec && dec.status) || '').toLowerCase();
      if (st === 'approved' || st === 'verified' || st === 'completed' || st === 'success') {
        await userDoc.ref.update({ kycStatus: 'verified', kycVerifiedAt: new Date(), updatedAt: new Date() });
      }
    }

    const syncRes = await syncUserActiveContracts(userDoc.id);
    const user = syncRes.user;
    const activeContracts = syncRes.activeContracts;

    const myAccSnap = await db.collection('saas_accounts').where('ownerUserId', '==', user.userId).get();
    const isKycOk = true;

    res.send(`<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>契約・プラン選択｜X-Swarm</title>
  <style>${COMMON_STYLE}</style>
</head>
<body>
  ${renderHeader(user, 'contract', req)}
  <div class="container">

    <!-- 1. 現在の合算スペック -->
    <div class="card" style="background:var(--brand-grad);color:#fff;border:none;">
      <div class="card-head">
        <h2 class="card-title" style="color:#fff;">現在の有効スペック合計</h2>
        <span class="badge" style="background:rgba(255,255,255,0.18);color:#fff;">
          ${activeContracts.length > 0 ? `契約 ${activeContracts.length} 件稼働中` : '無料枠'}
        </span>
      </div>
      <div class="grid4" style="background:rgba(255,255,255,0.08);padding:12px;border-radius:12px;">
        <div>
          <div style="font-size:11px;color:#CBD5E1;">同時稼働合計</div>
          <div style="font-size:18px;font-weight:900;color:#38BDF8;">同時 ${user.maxThreads || 1} 個</div>
        </div>
        <div>
          <div style="font-size:11px;color:#CBD5E1;">登録枠合計</div>
          <div style="font-size:18px;font-weight:900;">${myAccSnap.size} / ${user.maxAccounts || 1} 枠</div>
        </div>
        <div>
          <div style="font-size:11px;color:#CBD5E1;">専用国内回線</div>
          <div style="font-size:18px;font-weight:900;color:#34D399;">${(user.assignedProxies || []).length} 本</div>
        </div>
        <div>
          <div style="font-size:11px;color:#CBD5E1;">最短ペース</div>
          <div style="font-size:16px;font-weight:900;color:#FDE047;">${user.minIntervalMin === 1440 ? '1日1回' : `最短 ${user.minIntervalMin} 分`}</div>
        </div>
      </div>

      ${activeContracts.length > 0 ? `
      <div style="margin-top:14px;padding-top:12px;border-top:1px solid rgba(255,255,255,0.14);">
        <div style="font-size:12px;font-weight:800;color:#CBD5E1;margin-bottom:8px;">📋 稼働中の契約リスト（契約ごとに個別の有効期限で管理）</div>
        ${activeContracts.map((c, idx) => {
          const expDate = c.expiresAt && c.expiresAt.toDate ? c.expiresAt.toDate() : new Date();
          const remainHours = Math.max(0, Math.ceil((expDate.getTime() - Date.now()) / (3600 * 1000)));
          const remainLabel = remainHours <= 48 ? `残り ${remainHours} 時間` : `残り ${Math.ceil(remainHours / 24)} 日`;
          return `
          <div style="background:rgba(255,255,255,0.1);border-radius:10px;padding:10px 12px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
            <div>
              <div style="font-weight:900;font-size:13px;color:#fff;">契約 #${idx + 1}：${c.title}</div>
              <div style="font-size:11.5px;color:#CBD5E1;">
                同時+${c.threads} ／ 枠+${c.accounts} ／ 回線+${c.ispCount}本 ／ 期限: <b style="color:#FDE047;">${expDate.toLocaleDateString('ja-JP')}（${remainLabel}）</b>
              </div>
            </div>
            <form action="/saas/extend-contract" method="POST" style="margin:0;">
              <input type="hidden" name="contractId" value="${c.id}">
              <button type="submit" class="btn btn-teal" style="padding:6px 12px;font-size:12px;">
                🔄 更新（¥${(c.renewalPriceJpy || 4980).toLocaleString()}）
              </button>
            </form>
          </div>`;
        }).join('')}
      </div>
      ` : ''}
    </div>

    <!-- 2. 本人確認アピール（スマホでもボタン文字が絶対にはみ出さないスッキリ表記） -->
    ${!isKycOk ? `
    <div class="card" style="border:2px solid #F59E0B;background:linear-gradient(135deg,#FFFBEB 0%,#FFFFFF 100%);">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;flex-wrap:wrap;">
        <span class="badge" style="background:#F59E0B;color:#fff;font-size:11.5px;padding:4px 9px;">初回 30秒</span>
        <h3 style="margin:0;font-size:15px;font-weight:900;color:#92400E;">本人確認で ¥800お試しプラン＆全機能が解放されます</h3>
      </div>

      <div class="grid3" style="margin-bottom:14px;">
        <div style="background:#fff;border:1px solid #FDE68A;border-radius:12px;padding:11px;">
          <div style="font-weight:900;font-size:13px;color:#B45309;">⚡ 配信速度が最大288倍に</div>
          <div style="font-size:12px;color:var(--sub);margin-top:2px;">1日1回から、<b>最短5分おき（1日最大288回）</b>の超高速配信が解禁されます。</div>
        </div>
        <div style="background:#fff;border:1px solid #FDE68A;border-radius:12px;padding:11px;">
          <div style="font-weight:900;font-size:13px;color:#B45309;">🛡️ 専用の国内固定回線を付与</div>
          <div style="font-size:12px;color:var(--sub);margin-top:2px;">あなた専用の日本ISP固定プロキシ（通信無制限）が自動セットされ、凍結リスクを激減させます。</div>
        </div>
        <div style="background:#fff;border:1px solid #FDE68A;border-radius:12px;padding:11px;">
          <div style="font-weight:900;font-size:13px;color:#B45309;">🔄 複数同時稼働＆自動交代</div>
          <div style="font-size:12px;color:var(--sub);margin-top:2px;">複数アカウントで同時に発信し、制限時は予備アカウントへ自動でバトンタッチします。</div>
        </div>
      </div>

      <form action="/kyc/start-external" method="POST" style="margin:0;">
        <button type="submit" class="btn btn-teal" style="width:100%;padding:13px;font-size:14px;">
          📷 スマホで本人確認をはじめる（約30秒）
        </button>
      </form>
    </div>
    ` : ''}

    
      <!-- 📊 視覚で3秒でわかる！X-Swarm Cloud 図解フロー ＆ 従来Botとの違い -->
      <div class="card" style="background:linear-gradient(135deg,#0F172A 0%,#1E293B 100%);color:#fff;border:1px solid #334155;">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-bottom:12px;">
          <h2 style="margin:0;font-size:16px;font-weight:900;color:#fff;">📊 【図解】なぜ X-Swarm は凍結・シャドウバンで止まらないのか？</h2>
          <span class="badge" style="background:#10B981;color:#fff;font-weight:900;padding:4px 10px;border-radius:99px;font-size:11px;">100% Cloud Automated</span>
        </div>

        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:10px;margin-bottom:14px;">
          <div style="background:rgba(255,255,255,0.07);border:1px solid rgba(56,189,248,0.35);border-radius:12px;padding:12px;">
            <div style="font-size:11px;font-weight:900;color:#38BDF8;margin-bottom:4px;">STEP 1. AuthToken直挿し</div>
            <div style="font-size:13px;font-weight:800;margin-bottom:4px;">🔑 パスワード・API不要</div>
            <div style="font-size:11.5px;color:#CBD5E1;line-height:1.45;">40文字の <code style="color:#FDE047;">auth_token</code> を貼るだけ。高価なX公式API課金は不要。</div>
          </div>
          <div style="background:rgba(255,255,255,0.07);border:1px solid rgba(52,211,153,0.35);border-radius:12px;padding:12px;">
            <div style="font-size:11px;font-weight:900;color:#34D399;margin-bottom:4px;">STEP 2. 国別専用ISP回線</div>
            <div style="font-size:13px;font-weight:800;margin-bottom:4px;">🌍 固定住宅IPを自動割当</div>
            <div style="font-size:11.5px;color:#CBD5E1;line-height:1.45;">選択した国（US/UK/EU/JP等）の専用ISPプロキシでログインし、IP変動BANを防止。</div>
          </div>
          <div style="background:rgba(255,255,255,0.07);border:1px solid rgba(250,204,21,0.35);border-radius:12px;padding:12px;">
            <div style="font-size:11px;font-weight:900;color:#FDE047;margin-bottom:4px;">STEP 3. 人間行動＆難読化</div>
            <div style="font-size:13px;font-weight:800;margin-bottom:4px;">✍️ 1文字ずつの人間タイピング</div>
            <div style="font-size:11.5px;color:#CBD5E1;line-height:1.45;">ホーム回遊＋タイピング揺らぎ＋不可視文字付与でスパム検知AIを回避。</div>
          </div>
          <div style="background:rgba(255,255,255,0.07);border:1px solid rgba(244,114,182,0.4);border-radius:12px;padding:12px;">
            <div style="font-size:11px;font-weight:900;color:#F472B6;margin-bottom:4px;">STEP 4. 自動監査＆交代</div>
            <div style="font-size:13px;font-weight:800;margin-bottom:4px;">🔄 予備垢へ自動バトンタッチ</div>
            <div style="font-size:11.5px;color:#CBD5E1;line-height:1.45;">別プロファイルのチェッカーが検索反映を自動監査。制限時は予備垢へ即自動交代！</div>
          </div>
        </div>

        <div style="background:rgba(15,23,42,0.65);border:1px solid rgba(255,255,255,0.12);border-radius:12px;padding:10px 12px;font-size:12px;display:grid;grid-template-columns:1fr;gap:6px;">
          <div style="display:flex;align-items:center;gap:8px;color:#FCA5A5;">
            <span>❌ <b>一般的な自動投稿Bot：</b></span>
            <span>データセンターIP共有 ➔ API一括送信でシャドウバン ➔ 1垢止まると手動で入れ替えるまで完全停止</span>
          </div>
          <div style="display:flex;align-items:center;gap:8px;color:#6EE7B7;">
            <span>⭕ <b>X-Swarm Cloud：</b></span>
            <span><b>専用ISP固定回線つき ＋ 最短5分間隔（1日最大288投稿） ＋ 予備アカウント自動昇格で24時間ノンストップ稼働！</b></span>
          </div>
        </div>
      </div>

      <!-- 3. プラン選択 -->
    <div class="card">
      <div class="card-head">
        <h2 class="card-title">🚀 プランを選んでスピード解放（クレカ / PayPay / コンビニ / ギフト券 対応）</h2>
      </div>

      <form action="/saas/subscribe-custom" method="POST" style="margin:0;">
        <input type="hidden" name="basePlanId" id="basePlanId" value="oneday">

          <div style="background:#EFF6FF;border:1.5px solid #93C5FD;border-radius:12px;padding:12px 14px;margin-bottom:14px;">
            <label style="font-weight:900;font-size:13px;color:#1E3A8A;display:block;margin-bottom:6px;">
              🌍 専用ISP固定プロキシの国（Target Country）を選択 <span style="font-size:11px;color:#2563EB;font-weight:700;">※プラン料金に専用ISP回線が含まれています</span>
            </label>
            <select name="ispCountry" style="width:100%;padding:10px 12px;border-radius:10px;border:1px solid #60A5FA;background:#fff;font-weight:800;font-size:13.5px;color:#0F172A;margin:0;">
              ${ISP_COUNTRY_OPTIONS.map(o => `<option value="${o.code}" ${(user.ispCountry || 'US') === o.code ? 'selected' : ''}>${o.label}</option>`).join('')}
            </select>
          </div>


        <div class="plan-choice-grid">
          <!-- 🔥 1日お試しプラン (¥800 / 24h) -->
          <div class="plan-choice-card selected" id="card_oneday" onclick="selectPlanCard('oneday', 1080, 1, 3, 1, 5, 1)">
            <span class="plan-tag" style="background:var(--gold-grad);">🔥 まずは1日体験！</span>
            <div style="font-weight:900;font-size:15px;color:var(--text);">⏱️ 1日お試しプラン</div>
            <div style="font-size:24px;font-weight:900;color:#D97706;margin:4px 0;">$7 <span style="font-size:14px;color:var(--sub);">(¥1,080)</span> <span style="font-size:11.5px;color:var(--sub);font-weight:600;">/ 24h Trial</span></div>
            <div style="font-size:12px;color:#334155;line-height:1.75;margin-top:6px;">
              ・同時稼働：<b>1 スレッド</b><br>
              ・配信ペース：<b style="color:#D97706;">最短5分おき（最大288投稿）</b><br>
              ・登録枠合計：<b>3 枠（稼働1＋予備待機2）</b><br>
              ・専用国内回線：<b>1 本つき（通信無制限）</b>
            </div>
          </div>

          <!-- ライトプラン -->
          <div class="plan-choice-card" id="card_starter" onclick="selectPlanCard('starter', 12200, 1, 10, 1, 5, 30)">
            <div style="font-weight:900;font-size:15px;color:var(--text);">🚀 ライトプラン</div>
            <div style="font-size:24px;font-weight:900;color:var(--accent);margin:4px 0;">¥4,980 <span style="font-size:11.5px;color:var(--sub);font-weight:600;">/ 30日間</span></div>
            <div style="font-size:12px;color:#334155;line-height:1.75;margin-top:6px;">
              ・同時稼働：<b>1 スレッド</b><br>
              ・配信ペース：<b>最短15分おき（月2,880投稿）</b><br>
              ・登録枠合計：<b>5 枠（稼働1＋予備待機4）</b><br>
              ・専用国内回線：<b>1 本つき（通信無制限）</b>
            </div>
          </div>

          <!-- スタンダードプラン -->
          <div class="plan-choice-card" id="card_pro" onclick="selectPlanCard('pro', 27700, 3, 30, 3, 5, 30)">
            <span class="plan-tag">👑 一番人気・最短5分</span>
            <div style="font-weight:900;font-size:15px;color:var(--text);">⚡ スタンダードプラン</div>
            <div style="font-size:24px;font-weight:900;color:var(--accent);margin:4px 0;">¥9,800 <span style="font-size:11.5px;color:var(--sub);font-weight:600;">/ 30日間</span></div>
            <div style="font-size:12px;color:#334155;line-height:1.75;margin-top:6px;">
              ・同時稼働：<b>2 スレッド同時並行</b><br>
              ・配信ペース：<b style="color:var(--accent);">最短5分おき（月17,280投稿）</b><br>
              ・登録枠合計：<b>10 枠（稼働2＋予備待機8）</b><br>
              ・専用国内回線：<b>2 本つき（通信無制限）</b>
            </div>
          </div>

          <!-- ビジネスプラン -->
          <div class="plan-choice-card" id="card_business" onclick="selectPlanCard('business', 61800, 8, 100, 8, 5, 30)">
            <div style="font-weight:900;font-size:15px;color:var(--text);">🏢 ビジネスプラン</div>
            <div style="font-size:24px;font-weight:900;color:var(--emerald);margin:4px 0;">$399 <span style="font-size:14px;color:var(--sub);">(¥61,800)</span> <span style="font-size:11.5px;color:var(--sub);font-weight:600;">/ 30日間</span></div>
            <div style="font-size:12px;color:#334155;line-height:1.75;margin-top:6px;">
              ・同時稼働：<b>5 スレッド同時並行</b><br>
              ・配信ペース：<b style="color:var(--emerald);">最短5分おき（月43,200投稿）</b><br>
              ・登録枠合計：<b>25 枠（稼働5＋予備待機20）</b><br>
              ・専用国内回線：<b>5 本つき（通信無制限）</b>
            </div>
          </div>
        </div>

        <div style="background:var(--surface-sub);border:1px solid var(--border);border-radius:14px;padding:14px;">
          <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:12px;">
            <div>
              <div style="font-size:11.5px;color:var(--sub);font-weight:700;">選択中のパッケージ</div>
              <div id="selectedPlanSummaryText" style="font-size:13.5px;font-weight:900;color:var(--text);margin-top:2px;">
                1日お試しプラン（24時間有効 ／ 同時1個 ／ 最短5分 ／ 合計3枠 ／ 専用回線1本）
              </div>
            </div>
            <div style="text-align:right;margin-left:auto;">
              <div style="font-size:11px;color:var(--sub);">お支払い合計（税込）</div>
              <div id="summaryPrice" style="font-size:26px;font-weight:900;color:var(--text);line-height:1.1;">¥800</div>
            </div>
          </div>
          <button type="submit" class="btn" style="width:100%;padding:13px;font-size:14px;" ${!isKycOk ? 'disabled' : ''}>
            ${isKycOk ? 'お支払い方法の選択へ進む ❯' : '※先に上の「スマホで本人確認」を完了してください'}
          </button>
        </div>

        <details class="opt-box" style="margin-top:14px;margin-bottom:0;">
          <summary>⚙️ 上級者向けオプション（スレッド追加・シリアルコード入力）を開く</summary>
          <div style="margin-top:14px;padding-top:14px;border-top:1px solid var(--border);">
            <div class="grid2">
              <div>
                <label>同時稼働スレッドを追加（＋¥3,980 / 1個 ※専用回線1本＋予備3枠付）</label>
                <div class="stepper">
                  <button type="button" class="step-ctrl" onclick="stepNum('extraThreads', -1, 0, 50)">－</button>
                  <input type="number" name="extraThreads" id="extraThreads" class="step-val" value="0" min="0" max="50" onchange="calcTotal()" oninput="calcTotal()">
                  <button type="button" class="step-ctrl" onclick="stepNum('extraThreads', 1, 0, 50)">＋</button>
                  <span style="font-size:12px;color:var(--sub);">個 追加</span>
                </div>

                <label>予備の待機枠だけ追加（＋¥300 / 1枠）</label>
                <div class="stepper">
                  <button type="button" class="step-ctrl" onclick="stepNum('extraAccounts', -1, 0, 100)">－</button>
                  <input type="number" name="extraAccounts" id="extraAccounts" class="step-val" value="0" min="0" max="100" onchange="calcTotal()" oninput="calcTotal()">
                  <button type="button" class="step-ctrl" onclick="stepNum('extraAccounts', 1, 0, 100)">＋</button>
                  <span style="font-size:12px;color:var(--sub);">枠 追加</span>
                </div>
              </div>

              <div>
                <label>シリアルコード・バウチャーコード（入力で即時有効化）</label>
                <input type="text" name="couponCode" placeholder="例: VP-XXXX-XXXX（空欄でお支払い画面へ）">
                <input type="hidden" name="extraIsp" value="0">
                <input type="hidden" name="force5Min" value="no">
              </div>
            </div>
          </div>
        </details>
      </form>
    </div>

    ${renderFooter(user)}
  </div>

  <script>
    let curBasePrice = 1080;
    let curBaseThreads = 1;
    let curBaseAcc = 3;
    let curBaseIsp = 1;
    let curBaseInt = 5;
    let curDurationDays = 1;
    let curBaseTitle = '1日お試しプラン';

    function selectPlanCard(planId, price, threads, acc, isp, minInt, days) {
      document.getElementById('basePlanId').value = planId;
      curBasePrice = price;
      curBaseThreads = threads;
      curBaseAcc = acc;
      curBaseIsp = isp;
      curBaseInt = minInt;
      curDurationDays = days;
      curBaseTitle = planId === 'oneday' ? '1日お試しプラン' : (planId === 'starter' ? 'ライトプラン' : (planId === 'pro' ? 'スタンダードプラン' : 'ビジネスプラン'));

      ['oneday', 'starter', 'pro', 'business'].forEach(id => {
        const el = document.getElementById('card_' + id);
        if (el) el.classList.toggle('selected', id === planId);
      });
      calcTotal();
    }

    function calcTotal() {
      const extraThreads = Math.max(0, parseInt(document.getElementById('extraThreads').value || '0', 10));
      const extraAcc = Math.max(0, parseInt(document.getElementById('extraAccounts').value || '0', 10));

      const totalThreads = curBaseThreads + extraThreads;
      const totalAcc = curBaseAcc + (extraThreads * 3) + extraAcc;
      const totalIsp = curBaseIsp + extraThreads;
      const totalPrice = curBasePrice + (extraThreads * 7500) + (extraAcc * 750);
      const dayLabel = curDurationDays === 1 ? '24時間有効' : '30日間有効';

      document.getElementById('selectedPlanSummaryText').innerText =
        curBaseTitle + '（' + dayLabel + ' ／ 同時' + totalThreads + '個 ／ 最短' + curBaseInt + '分 ／ 合計' + totalAcc + '枠 ／ 専用回線' + totalIsp + '本）';
      document.getElementById('summaryPrice').innerText = '¥' + totalPrice.toLocaleString();
    }
    calcTotal();
  </script>
</body>
</html>`);
  } catch (e) {
    res.status(500).send('エラー: ' + e.message);
  }
});

