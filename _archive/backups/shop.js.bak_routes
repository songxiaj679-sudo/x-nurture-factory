  }
  .ios-switch input { opacity: 0; width: 0; height: 0; margin: 0; }
  .ios-slider {
    position: absolute;
    cursor: pointer;
    inset: 0;
    background-color: rgba(255, 255, 255, 0.24);
    border: 1px solid rgba(255, 255, 255, 0.35);
    transition: .25s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 34px;
  }
  .ios-slider:before {
    position: absolute;
    content: "";
    height: 24px;
    width: 24px;
    left: 2px;
