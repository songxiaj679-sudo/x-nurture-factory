/**
 * 単一URLからWebサイトの主要メタ情報と本文テキストを抽出
 */
async function fetchSingleUrl(url) {
  try {
    const res = await fetch(url, {
      headers: {
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36 VeloxCrawler/4.0'
      },
      signal: AbortSignal.timeout(10000)
    });

    if (!res.ok) {
      return { ok: false, url, error: `HTTP ${res.status}: ${res.statusText}` };
    }

    const html = await res.text();

    const titleMatch = html.match(/<title[^>]*>([^<]+)<\/title>/i);
    const title = titleMatch ? titleMatch[1].trim() : '';

    const metaDescMatch = html.match(/<meta[^>]*name=["']description["'][^>]*content=["']([^"']+)["']/i) ||
                          html.match(/<meta[^>]*content=["']([^"']+)["'][^>]*name=["']description["']/i) ||
                          html.match(/<meta[^>]*property=["']og:description["'][^>]*content=["']([^"']+)["']/i);
    const description = metaDescMatch ? metaDescMatch[1].trim() : '';

    const headings = [];
    const headingRegex = /<h[1-3][^>]*>([\s\S]*?)<\/h[1-3]>/gi;
    let hMatch;
    while ((hMatch = headingRegex.exec(html)) !== null && headings.length < 8) {
      const txt = hMatch[1].replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
      if (txt && txt.length > 4 && txt.length < 80) {
        headings.push(txt);
      }
    }

    const bodyClean = html
      .replace(/<script[\s\S]*?<\/script>/gi, '')
      .replace(/<style[\s\S]*?<\/style>/gi, '')
      .replace(/<nav[\s\S]*?<\/nav>/gi, '')
      .replace(/<footer[\s\S]*?<\/footer>/gi, '')
      .replace(/<[^>]+>/g, ' ')
      .replace(/\s+/g, ' ')
      .trim()
      .slice(0, 2500);

    return {
      ok: true,
      url,
      title,
      description,
      headings,
      snippet: bodyClean
    };
  } catch (err) {
    return { ok: false, url, error: err.message };
  }
}

/**
 * 宣伝対象のURLからWebサイトの主要メタ情報と本文テキストを抽出（複数URL対応）
 */
async function fetchUrlSummary(targetUrl) {
  if (!targetUrl || typeof targetUrl !== 'string') {
    return { ok: false, error: 'URLが指定されていません' };
  }

  // 複数URLの抽出（改行、カンマ、スペース区切り対応）
  const urlMatches = [...targetUrl.matchAll(/https?:\/\/[^\s,;\n]+/g)].map(m => m[0]);
  const urls = urlMatches.length > 0 ? [...new Set(urlMatches)].slice(0, 5) : [targetUrl.trim()];

  if (urls.length === 1) {
    return await fetchSingleUrl(urls[0]);
  }

  // 複数URLを並行取得して統合
  const results = await Promise.allSettled(urls.map(u => fetchSingleUrl(u)));
  const successful = results
    .filter(r => r.status === 'fulfilled' && r.value && r.value.ok)
    .map(r => r.value);

  if (successful.length === 0) {
    const firstErr = results.find(r => r.status === 'fulfilled' && r.value && !r.value.ok)?.value?.error || '複数URLの取得に失敗しました';
    return { ok: false, error: firstErr };
  }

  const combinedTitle = successful.map(s => s.title).filter(Boolean).join(' | ');
  const combinedDesc = successful.map(s => s.description).filter(Boolean).join(' / ');
  const combinedHeadings = [...new Set(successful.flatMap(s => s.headings))].slice(0, 10);
  const combinedSnippet = successful.map((s, idx) => `[URL ${idx + 1}: ${s.url}]\nタイトル: ${s.title}\n${s.snippet}`).join('\n\n').slice(0, 4500);

  return {
    ok: true,
    url: urls.join(', '),
    urls: successful.map(s => s.url),
    title: combinedTitle,
    description: combinedDesc,
    headings: combinedHeadings,
    snippet: combinedSnippet,
    isMultiUrl: true
  };
}

/**
 * 段階的プロンプト [Pass 1]: URL情報 + ユーザープロンプト + 集合知ナレッジに基づく市場分析 (日英両言語対応)
 */
async function analyzeMarketWithUserPrompt(pageInfo, userPrompt, collectiveKnowledge, userKnowledge) {
  const GEMINI_API_KEY = process.env.GEMINI_API_KEY;
  if (!GEMINI_API_KEY) throw new Error('GEMINI_API_KEYが設定されていません');

  const genAI = new GoogleGenerativeAI(GEMINI_API_KEY);
  const model = genAI.getGenerativeModel({ model: 'gemini-3.8-flash' });

  const successTips = (collectiveKnowledge.successPatterns || []).slice(0, 3).map(p => `・${p.patternName}: ${p.syntaxRule}`).join('\n');
  const failureTips = (collectiveKnowledge.failurePatterns || []).slice(0, 3).map(p => `・${p.patternName}: ${p.flawReason}`).join('\n');

  const prompt = `あなたはB2B・X(Twitter)マーケティングの最高戦略アナリストです。
以下のWebサイト情報、お客様からの個別指示（ユーザープロンプト）、および全クライアントの集合知ナレッジを総合分析し、最も売上・商談に直結する【市場分析 ＆ ポジショニング戦略】を日英両言語（日本語とビジネス英語）を含むJSON形式で作成してください。

【お客様からの直接カスタム指示（最優先）】
${userPrompt ? userPrompt : '（特になし：サイト情報から最も確度の高いターゲットを自律判定してください）'}

【宣伝対象のWebサイト情報】
- URL: ${pageInfo.url}
- タイトル: ${pageInfo.title || '(なし)'}
- 説明: ${pageInfo.description || '(なし)'}
- 見出し: ${pageInfo.headings ? pageInfo.headings.join(' / ') : '(なし)'}
- 本文抜粋: ${pageInfo.snippet || '(なし)'}

【全顧客の集合知ナレッジ（成功・失敗傾向）】
[成功パターン]
${successTips}
[避けるべき失敗パターン]
${failureTips}

【出力JSONフォーマット】
{
  "serviceName": "サービス名・事業名",
  "oneLineSummary": "30字以内のコア提供価値（日本語）",
  "oneLineSummary_en": "Core value proposition within 15 words (Executive Business English)",
  "targetAudience": "最も刺さるターゲット顧客層（日本語：職業、役職、深い悩み、年代）",
  "targetAudience_en": "Target audience persona (Executive Business English: role, ICP, pain points)",
  "userPainPoints": ["顧客の生々しい課題1", "課題2", "課題3"],
  "userPainPoints_en": ["Key pain point 1 in English", "Key pain point 2 in English", "Key pain point 3 in English"],
  "uniqueSellingPoints": ["競合に対する絶対的差別化要素1", "要素2"],
  "uniqueSellingPoints_en": ["Competitive differentiator 1 in English", "Differentiator 2 in English"],
  "toneOfVoice": "最も成約率が高まる発信トーン（日本語）",
  "toneOfVoice_en": "Optimal tone of voice (Executive Business English)",
  "coreAppealAngle": "今回のマーケティングで最もフォーカスすべき訴求軸（日本語）",
  "coreAppealAngle_en": "Core strategic appeal angle (Executive Business English)",
  "userPromptReflected": "ユーザープロンプトをどのように戦略に反映したかの解説（日本語：1〜2文）",
  "userPromptReflected_en": "Explanation of how user directives were reflected (Executive Business English: 1-2 sentences)"
}`;

  try {
    const result = await model.generateContent(prompt);
    const cleaned = result.response.text().replace(/```json/g, '').replace(/```/g, '').trim();
    const parsed = JSON.parse(cleaned);
    return parsed;
  } catch (e) {
    return {
      serviceName: (pageInfo.title || '').slice(0, 20) || '提供サービス',
      oneLineSummary: (pageInfo.description || '').slice(0, 30) || '業務の自動化・効率化ソリューション',
      oneLineSummary_en: 'Autonomous Social Pipeline & B2B Growth Infrastructure',
      targetAudience: '成果と効率化を求める経営者・マーケティング責任者・個人事業主',
      targetAudience_en: 'Enterprise executives, B2B founders, and marketing directors seeking scalable deal flow',
      userPainPoints: ['運用の工数が逼迫している', '成果に繋がる導線が作れない', 'アカウント停止や規約違反が不安'],
      userPainPoints_en: ['Exhausting 30+ monthly hours on manual post creation', 'Near-zero pipeline conversion from vanity impressions', 'Fearing algorithmic reach penalties and account suspension'],
      uniqueSellingPoints: ['公式API完全準拠による凍結リスクゼロ', '7名AI合議制による成約特化設計'],
      uniqueSellingPoints_en: ['Strict official X API v2 compliance (zero ban risk)', '7-agent dialectical deliberation optimizing pipeline conversion'],
      toneOfVoice: '論理的で信頼性の高いB2Bプロフェッショナル口調',
      toneOfVoice_en: 'Authoritative, objective, respectful enterprise tone without AI hype',
      coreAppealAngle: '属人作業からの完全解放と安全な自律化基盤',
      coreAppealAngle_en: 'Overcoming manual overhead and establishing an autonomous, compliant deal pipeline',
      userPromptReflected: userPrompt ? `ご指定の指示（${userPrompt.slice(0, 30)}）に基づき、ターゲットの課題解決と商談獲得にフォーカスしました` : 'サイト分析結果を元に最適な訴求を設計しました',
      userPromptReflected_en: userPrompt ? `Directives reflected: Aligned core appeal with "${userPrompt.slice(0, 50)}" to target executive decision-makers.` : 'Optimized high-intent B2B conversion angles based on source page intelligence.'
    };
  }
}

