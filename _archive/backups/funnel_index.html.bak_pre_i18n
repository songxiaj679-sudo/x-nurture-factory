  <!-- ========================================================================
       VIEW 1: GLOBAL B2B FLAGSHIP SHOWCASE (日本語・英語調和 & 公式ビジネス仕様)
       ======================================================================== -->
  <div id="guestShowcaseView">
    <!-- SECTION 1: Hero Banner -->
    <section class="hero-banner">
      <div class="hero-inner">
        <div class="hero-visual-col" style="display:flex; flex-direction:column; gap:14px; width:100%;">
          <div class="hero-visual-frame" style="background:#FFFFFF; border:1px solid #E2E8F0; padding:10px; border-radius:24px; box-shadow:0 25px 50px -12px rgba(15,23,42,0.12); position:relative; overflow:hidden;">
            <img src="/images/hero-dashboard-mockup.png?v=20261113" alt="VeloxPost Cloud Autonomous AI Marketing System" style="width:100%; height:auto; display:block; border-radius:16px; object-fit:cover;" />
            <div style="position:absolute; bottom:16px; left:16px; right:16px; display:flex; justify-content:space-between; align-items:center; background:rgba(15,23,42,0.85); backdrop-filter:blur(10px); padding:8px 14px; border-radius:12px; border:1px solid rgba(255,255,255,0.12);">
              <div style="display:flex; align-items:center; gap:8px;">
                <span style="color:#10B981;font-family:'JetBrains Mono',monospace;font-size:0.75rem;font-weight:bold;">● 7-AI COUNCIL ACTIVE</span>
                <span style="font-family:'JetBrains Mono',monospace;font-size:0.75rem;color:#E2E8F0;">Official X API v2 Deliberation Engine</span>
              </div>
              <span style="background:#2563EB;color:#FFF;padding:3px 10px;border-radius:999px;font-weight:800;font-size:0.7rem;letter-spacing:0.04em;">ENTERPRISE ARCHITECTURE</span>
            </div>
          </div>

          <!-- Secondary Telemetry Strip matching height with right column -->
          <div class="hero-telemetry-strip" style="background:#FFFFFF; border:1px solid #E2E8F0; border-radius:16px; padding:14px 20px; box-shadow:0 10px 25px -5px rgba(15,23,42,0.05); display:grid; grid-template-columns:repeat(3, 1fr); gap:12px; text-align:center;">
            <div style="border-right:1px solid #F1F5F9; padding-right:8px;">
              <div style="font-size:0.72rem; font-weight:800; color:#64748B; margin-bottom:2px;" data-i18n="hero_telem1_label">商談獲得効率</div>
              <div style="font-size:1.4rem; font-weight:900; color:#2563EB; line-height:1.2;">3.2x</div>
              <div style="font-size:0.67rem; color:#059669; font-weight:700; margin-top:2px;" data-i18n="hero_telem1_sub">公式API正規通信</div>
            </div>
            <div style="border-right:1px solid #F1F5F9; padding-right:8px;">
              <div style="font-size:0.72rem; font-weight:800; color:#64748B; margin-bottom:2px;" data-i18n="hero_telem2_label">アカウント停止率</div>
              <div style="font-size:1.4rem; font-weight:900; color:#059669; line-height:1.2;">0.00%</div>
              <div style="font-size:0.67rem; color:#059669; font-weight:700; margin-top:2px;" data-i18n="hero_telem2_sub">規約・法令完全遵守</div>
            </div>
            <div>
              <div style="font-size:0.72rem; font-weight:800; color:#64748B; margin-bottom:2px;" data-i18n="hero_telem3_label">運用工数削減</div>
              <div style="font-size:1.4rem; font-weight:900; color:#7C3AED; line-height:1.2;">90%</div>
              <div style="font-size:0.67rem; color:#64748B; font-weight:700; margin-top:2px;" data-i18n="hero_telem3_sub">7-Agent 合議推敲</div>
            </div>
          </div>
        </div>

        <div class="hero-copy-box">
          <div style="font-weight:800;font-size:0.82rem;color:#2563EB;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:10px;">
            ENTERPRISE AUTONOMOUS SOCIAL GROWTH INFRASTRUCTURE
          </div>
          <h1 id="heroH1" data-i18n="hero_h1">VeloxPost Cloud 4.0<br><span style="color:#2563EB;">自律型AIマーケティング基盤</span></h1>
          <p style="font-size:1.03rem;color:#374151;font-weight:500;line-height:1.75;" id="heroDesc" data-i18n="hero_desc">
            X（旧Twitter）公式API v2完全準拠。日本の各種法令およびプラットフォーム規約を厳格に遵守し、企業のブランド価値と社会的信用を守りながら、SNS上での見込み客開拓・商談獲得を24時間365日自律化。7名の専門家AI評議会（7-Agent Dialectical Consensus）が過去のエンゲージメントデータを自己学習し、売上に直結する最適解を自律生成します。個人事業主から成長企業まで、安心・安全な高信頼マーケティングDX基盤を提供します。
          </p>
          <div style="display:flex;align-items:center;gap:8px;margin-top:18px;flex-wrap:wrap;">
            <span style="background:#EFF6FF;color:#2563EB;padding:5px 12px;border-radius:999px;font-size:0.75rem;font-weight:800;border:1px solid #BFDBFE;" data-i18n="hero_badge1">🛡️ X公式API v2正規通信（凍結リスクゼロ）</span>
            <span style="background:#F0FDF4;color:#166534;padding:5px 12px;border-radius:999px;font-size:0.75rem;font-weight:800;border:1px solid #BBF7D0;" data-i18n="hero_badge2">🏛️ 日本国内法令 & APPI（個人情報保護法）完全遵守</span>
            <span style="background:#F8FAFC;color:#334155;padding:5px 12px;border-radius:999px;font-size:0.75rem;font-weight:800;border:1px solid #CBD5E1;" data-i18n="hero_badge3">💳 Stripe公式決済（PCI-DSS L1・適格インボイス対応）</span>
            <span style="background:#FAF5FF;color:#6B21A8;padding:5px 12px;border-radius:999px;font-size:0.75rem;font-weight:800;border:1px solid #E9D5FF;" data-i18n="hero_badge4">🤝 ブランド価値と社会的信用を守る安全設計</span>
          </div>
          <div class="hero-cta-group">
            <button type="button" class="btn-nav-blue" style="padding:14px 30px;font-size:0.94rem;" onclick="openUnlockModal()" data-i18n="hero_btn_select">エディションを選択する →</button>
            <a href="#liveDemoSection" class="btn-hero-white" data-i18n="hero_btn_demo">無料ライブデモを体験</a>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: 開発思想・エンジニアリング原則 -->
    <section id="secReviews" class="editorial-sec">
      <div style="text-align:center;max-width:820px;margin:0 auto 28px;">
        <span style="background:#EFF6FF;color:#2563EB;padding:4px 14px;border-radius:999px;font-size:0.75rem;font-weight:900;letter-spacing:0.06em;text-transform:uppercase;">PHILOSOPHY & PRINCIPLES</span>
        <h2 class="sec-h2" style="font-size:2.1rem;margin:10px 0 12px;">私たちが約束する 4つのコンプライアンス＆開発原則</h2>
        <p style="font-size:0.95rem;color:#475569;line-height:1.7;">
          世の中に溢れる「スパム的な自動投稿Bot」がなぜ成果を出せず、アカウント停止や社会的信用の失墜を招くのか。私たちはその原因を徹底分析し、日本国内の諸法令・X公式API規約・Stripe公式決済基準に完全準拠した、高信頼の自律マーケティングDX基盤を確立しました。
        </p>
      </div>

      <div class="media-quotes-grid" style="grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));">
        <div class="media-card" style="border-top: 3px solid #2563EB;">
          <h3 style="font-size:1.02rem;font-weight:900;color:#0F172A;margin-bottom:8px;">01. 日本国内諸法令 & 公式規約の厳格遵守</h3>
          <p style="font-size:0.86rem;line-height:1.65;color:#475569;">特定商取引法、個人情報保護法（APPI）、不正アクセス禁止法、電気通信事業法、およびX公式Developer規約に100%準拠。非公認スクレイピングや裏ワザ的Botを完全排除し、事業主の信用を守り抜きます。</p>
          <span style="color:#2563EB;font-weight:800;font-size:0.75rem;">ZERO SUSPENSION RISK • COMPLIANCE</span>
        </div>
        <div class="media-card" style="border-top: 3px solid #059669;">
          <h3 style="font-size:1.02rem;font-weight:900;color:#0F172A;margin-bottom:8px;">02. ブランド価値と社会的信用の保護</h3>
          <p style="font-size:0.86rem;line-height:1.65;color:#475569;">公序良俗に反する無差別メンション、過度な煽り、迷惑リプライをシステムレベルで遮断。企業のブランド価値と社会的信用を守り、読者に真の価値を提供する良質なコンテンツのみを自律生成します。</p>
          <span style="color:#059669;font-weight:800;font-size:0.75rem;">BRAND REPUTATION & ETHICS</span>
        </div>
        <div class="media-card" style="border-top: 3px solid #4F46E5;">
          <h3 style="font-size:1.02rem;font-weight:900;color:#0F172A;margin-bottom:8px;">03. Stripe公式暗号化決済 & インボイス対応</h3>
          <p style="font-size:0.86rem;line-height:1.65;color:#475569;">国際最高水準PCI-DSS Level 1認定のStripe公式インフラを採用。カード番号は完全非保持化。個人事業主の事業用カードや法人カードに幅広く対応し、適格請求書（インボイス制度）準拠の電子領収書を即時発行します。</p>
          <span style="color:#4F46E5;font-weight:800;font-size:0.75rem;">PCI-DSS L1 SECURE BILLING</span>
        </div>
        <div class="media-card" style="border-top: 3px solid #7C3AED;">
          <h3 style="font-size:1.02rem;font-weight:900;color:#0F172A;margin-bottom:8px;">04. 7名AI合議制による是々非々の批判的推敲</h3>
          <p style="font-size:0.86rem;line-height:1.65;color:#475569;">単一AIの定型文・イエスマン応答を完全排除。7名の専門AIがディベートを交わし、プロのマーケティング顧問チームのようにアカウントの持続的な成長と成約率を最大化します。</p>
          <span style="color:#7C3AED;font-weight:800;font-size:0.75rem;">7-AGENT CRITICAL DELIBERATION</span>
        </div>
      </div>
    </section>

    <!-- SECTION 3: 5大コアアーキテクチャ -->
    <section id="secExplorer" class="interactive-explorer-sec">
      <div class="sec-center">
        <span class="sec-eyebrow">SYSTEM ARCHITECTURE</span>
        <h2 class="sec-h2">成果を科学する5大エンジニアリング</h2>
        <p class="sec-lead">VeloxPost Cloud 4.0を支える5つのコア技術。単なる自動投稿とは根本的に異なる、エンタープライズ水準の自律グロース基盤です。</p>
      </div>

      <div class="explorer-tabs-bar">
        <button type="button" class="exp-tab-btn active" id="etab_0" onclick="switchExplorerTab(0)">
          <span>01. 公式API v2暗号化</span><span class="plus-circle">＋</span>
        </button>
        <button type="button" class="exp-tab-btn" id="etab_1" onclick="switchExplorerTab(1)">
          <span>02. 7名AI合議ディベート</span><span class="plus-circle">＋</span>
        </button>
        <button type="button" class="exp-tab-btn" id="etab_2" onclick="switchExplorerTab(2)">
          <span>03. ナレッジ自己進化</span><span class="plus-circle">＋</span>
        </button>
        <button type="button" class="exp-tab-btn" id="etab_3" onclick="switchExplorerTab(3)">
          <span>04. シンジケート初速加速</span><span class="plus-circle">＋</span>
        </button>
        <button type="button" class="exp-tab-btn" id="etab_4" onclick="switchExplorerTab(4)">
          <span>05. 文脈認識AI営業</span><span class="plus-circle">＋</span>
        </button>
      </div>

      <div class="explorer-stage">
        <div class="explorer-visual-pane">
          <div class="explorer-img-wrap" style="background:#FFFFFF; border:1.5px solid #E2E8F0; display:flex; flex-direction:column; justify-content:space-between; align-items:center; padding:22px; border-radius:18px; box-shadow:0 10px 25px -5px rgba(0,0,0,0.04); min-height:420px;">
            <div style="flex:1; display:flex; align-items:center; justify-content:center; width:100%; padding:10px 0;">
              <img id="explorerStageImg" src="/images/feature-cloud-vault-3d.png?v=20261113_6" alt="Cloud Vault Enterprise Architecture" style="width:100%; max-height:220px; object-fit:contain; display:block; transition:opacity 0.2s;" />
            </div>
            <div id="explorerLiveTelemetry" style="margin-top:14px; width:100%; background:#F8FAFC; border:1px solid #E2E8F0; border-radius:12px; padding:12px 16px; display:flex; justify-content:space-between; align-items:center;">
              <div>
                <div id="expTelemTitle" style="font-size:0.78rem; font-weight:900; color:#0F172A;">X Official API v2 / AES-256-GCM Vault</div>
                <div id="expTelemSub" style="font-size:0.7rem; color:#059669; font-weight:800;">● 日本国内諸法令 & X公式規約 100% 準拠</div>
              </div>
              <span id="expTelemBadge" style="background:#ECFDF5; color:#059669; font-size:0.7rem; font-weight:800; padding:4px 12px; border-radius:999px;">正規暗号化接続中</span>
            </div>
          </div>
          <div class="explorer-desc-card">
            <div style="font-size:0.76rem;font-weight:900;color:#2563EB;letter-spacing:0.06em;margin-bottom:8px;" id="expCardTag">OFFICIAL API SECURITY</div>
            <h3 id="expCardTitle">X公式API v2準拠 & AES-256暗号化基盤</h3>
            <p style="font-size:0.94rem;color:#4B5563;line-height:1.75;" id="expCardBody">
              非公式なBotツールとは異なり、X（旧Twitter）公式API v2に完全準拠。企業や事業主の重要アカウントの凍結（サスペンド）リスクをゼロに抑え、プラットフォーム規約を守りながら最大のパフォーマンスを発揮します。
            </p>
            <div class="spec-mini-list" id="expSpecList">
              <div class="spec-mini-row"><span>PILLAR 01 — 公式API v2準拠</span><strong>凍結リスクゼロ</strong></div>
              <div class="spec-mini-row"><span>PILLAR 02 — 認証情報暗号化</span><strong>AES-256-GCM</strong></div>
              <div class="spec-mini-row"><span>PILLAR 03 — 7名合議制AI</span><strong>多角ディベート推敲</strong></div>
              <div class="spec-mini-row"><span>PILLAR 04 — ナレッジ自己進化</span><strong>実績自動学習ループ</strong></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: 性能と高可用性 -->
    <section id="secPerformance" class="sec-container" style="padding-top:32px;">
      <div style="max-width:1140px; margin:36px auto; border-radius:24px; overflow:hidden; background:linear-gradient(135deg, #EFF6FF 0%, #FFFFFF 100%) !important; border:1.5px solid #BFDBFE; padding:36px 40px; color:#0F172A !important; position:relative; box-shadow:0 10px 30px -10px rgba(37,99,235,0.08); text-align:center;">
        <div style="position:relative; z-index:2; background:transparent !important; color:#0F172A !important;">
          <div style="font-family:'JetBrains Mono',monospace;font-size:0.8rem;font-weight:800;color:#2563EB;letter-spacing:0.1em;margin-bottom:12px;">
            OFFICIAL API COMPLIANCE × MULTI-AI DELIBERATION × SATELLITE ENGINE
          </div>
          <h3 style="font-size:clamp(1.5rem,3vw,2.2rem);font-weight:900;letter-spacing:-0.03em;line-height:1.35;max-width:850px;color:#0F172A;margin:0 auto;">
            見込み客の開拓から商談セットアップまで。<br><span style="color:#2563EB;">B2Bマーケティングを自動化する最高峰のインフラ。</span>
          </h3>
        </div>
      </div>

      <div class="sec-center" style="margin-top:48px;">
        <span class="sec-eyebrow">CONTINUOUS PIPELINE ENGINE</span>
        <h2 class="sec-h2">止まらない成長エンジン。24時間365日の自律稼働。</h2>
        <p class="sec-lead">
          一度ターゲットURLと基本方針を設定すれば、AI評議会が毎日の最適投稿タイミングを自動算出し、高エンゲージメント投稿を途切れることなく配信し続けます。
        </p>
      </div>

      <div class="dual-feature-grid">
        <div class="soft-feature-card">
          <div>
            <div style="font-size:0.85rem;font-weight:800;color:#4B5563;">Self-Evolving <strong style="font-size:2.2rem;color:#2563EB;">AI Engine</strong></div>
            <h3>過去データを自己学習。<br>使えば使うほど精度が高まる。</h3>
            <p>投稿後のインプレッション、いいね、リプライ、ブックマークを自動計測。成功要因と失敗反省点をアカウント専属ナレッジとして蓄積し、フォロワーに最も刺さる勝ちパターンへ自己進化します。</p>
          </div>
          <div class="card-visual-slot" style="padding:16px; background:#FFFFFF; border:1.5px solid #E2E8F0; border-radius:18px; box-shadow:0 10px 25px -5px rgba(0,0,0,0.04); display:flex; flex-direction:column; align-items:center; justify-content:center;">
            <img src="/images/feature-growth-3d.png?v=20261113_6" alt="Self-Evolving AI Growth" style="width:100%; max-height:200px; object-fit:contain; display:block;" />
            <div style="margin-top:12px; width:100%; background:#F8FAFC; border:1px solid #E2E8F0; border-radius:8px; padding:6px 12px; font-size:0.75rem; color:#1E40AF; text-align:center; font-weight:800;">
              📈 自律分析＆アカウント専属勝ちパターン蓄積
            </div>
          </div>
        </div>

        <div class="soft-feature-card">
          <div>
            <div style="font-size:0.85rem;font-weight:800;color:#4B5563;">Official <strong style="font-size:2.2rem;color:#2563EB;">X API v2</strong> Compliant</div>
            <h3>アカウント凍結リスクゼロ。<br>安心・安全な企業向けクリーン運用。</h3>
