        <a href="#secFaq" data-i18n="nav_faq">FAQ</a>
        <a href="/affiliate" style="color:#2563EB;" data-i18n="nav_affiliate">30% アフィリエイト ↗</a>
      </nav>
      <div class="nav-right-btns">
        <!-- 10-Language Stylish Glass Dropdown -->
        <div class="lang-dropdown-wrap" id="langDropdownWrap">
          <button type="button" class="lang-trigger-btn" onclick="toggleLangMenu(event)">
            <span id="curLangLabel">🌐 JA</span>
            <span style="font-size:0.65rem;opacity:0.7;">▼</span>
          </button>
          <div class="lang-menu-pop" id="langMenuPop">
            <button type="button" class="lang-opt" data-lang="en" data-label="🌐 EN — English" onclick="selectSiteLanguage('en', this)"><span>🇺🇸 English (Global)</span><span>EN</span></button>
            <button type="button" class="lang-opt active" data-lang="ja" data-label="🌐 JA — 日本語" onclick="selectSiteLanguage('ja', this)"><span>🇯🇵 日本語 (Japanese)</span><span>JA</span></button>
          </div>
        </div>

        <a href="/dashboard" id="topDashboardBtn" style="display:none;background:linear-gradient(135deg,#2563EB,#1D4ED8);color:#FFFFFF;padding:8px 16px;border-radius:10px;font-size:0.82rem;font-weight:800;text-decoration:none;box-shadow:0 2px 8px rgba(37,99,235,0.3);" data-i18n="nav_dashboard">📊 アカウント管理</a>
        <button type="button" class="btn-nav-outline" id="topAuthBtn" onclick="openAuthModal('login')" data-i18n="nav_login">ログイン</button>
        <button type="button" class="btn-nav-blue" id="topUnlockBtn" onclick="openAuthModal('register')" data-i18n="nav_signup">新規登録</button>
