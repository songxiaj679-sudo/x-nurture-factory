  // 3-C. 🏛️ AI合議結果の承認・スケジュールコミットAPI (Plan A / Plan B 選択対応)
  app.post('/api/autopilot/council/commit', async (req, res) => {
    try {
      const { userId = 'default_user', deliberationId, selectedPlan = 'planA', overrideTweets, overrideScheduledAt, plan = 'pro' } = req.body || {};
      if (!deliberationId) {
        return res.json({ ok: false, error: 'deliberationId が指定されていません' });
      }
      const result = await commitDeliberationToSchedule({
        userId,
        deliberationId,
        selectedPlan,
        overrideTweets,
        overrideScheduledAt,
        plan
      });
      res.json({
        ok: true,
        message: `🎉 AI合議で決定したポスト (${selectedPlan === 'planB' ? '⚡ Plan B: 対抗高拡散' : '🔥 Plan A: 王道高成約'}) を投稿スケジュールに確定登録しました！`,
        ...result
      });
    } catch (err) {
      console.error('Council commit error:', err.message);
      res.json({ ok: false, error: err.message });
    }
  });

  // 4. サテライト部隊の応援進捗一覧
  app.get('/api/hybrid/campaigns', async (req, res) => {
    try {
      const snap = await db.collection('boost_campaigns')
        .orderBy('createdAt', 'desc')
        .limit(20)
        .get();

      const campaigns = [];
      snap.forEach(doc => campaigns.push({ id: doc.id, ...doc.data() }));

      res.json({ ok: true, campaigns });
    } catch (err) {
      res.json({ ok: false, error: err.message });
    }
  });


  // ⏸/▶ 自律運用のスタート/ストップ（一時停止・再開）トグルAPI
  app.post('/api/autopilot/toggle-pause', async (req, res) => {
    try {
      const { userId = 'default_user', lang = 'ja' } = req.body || {};
      const userObj = await resolveUserDoc(userId);
      if (!userObj) {
        return res.json({ ok: false, error: 'User not found' });
      }

      const isPaused = Boolean(userObj.data.autopilotPaused);
      const nextPaused = !isPaused;

      await userObj.doc.ref.update({
        autopilotPaused: nextPaused,
        updatedAt: new Date()
      });

      res.json({
        ok: true,
        isPaused: nextPaused,
        message: nextPaused
          ? (lang === 'en' ? '⏸ Autonomous marketing has been paused.' : '⏸ 自律運用を一時停止しました。予約投稿の配信は保留されます。')
          : (lang === 'en' ? '▶ Autonomous marketing resumed!' : '▶ 自律運用を再開しました！スケジュール通りに自律投稿が行われます。')
      });
    } catch (e) {
      res.json({ ok: false, error: e.message });
    }
  });

  // 2-C. 🤖 手動で次回枠の予約投稿をAI合議生成・補充するAPI
  app.post('/api/autopilot/replenish', async (req, res) => {
    try {
      const { userId = 'default_user' } = req.body || {};
      const userObj = await resolveUserDoc(userId);
      if (!userObj || !userObj.data.targetUrl || !userObj.data.xOfficialCredentials) {
        return res.json({ ok: false, error: '先に【ステップ1: 公式API接続】と【ステップ2: ターゲットURL設定】を完了してください。' });
      }

      const jobsSnap = await db.collection('autopilot_jobs')
        .where('userId', '==', userObj.userId)
        .where('status', '==', 'pending')
        .get();

      let latestScheduleDate = new Date();
      jobsSnap.docs.forEach(d => {
        const s = d.data().scheduledAt;
        const sDate = s ? (s.toDate ? s.toDate() : new Date(s)) : new Date();
        if (sDate > latestScheduleDate) latestScheduleDate = sDate;
      });

      const nextStart = new Date(latestScheduleDate.getTime() + 8 * 3600 * 1000);

      const launchRes = await launchAutopilotCampaign(userObj.userId, userObj.data.targetUrl, {
        userPrompt: userObj.data.userPrompt || '',
        plan: userObj.data.planId || 'pro',
        isReplenish: true,
        startFromDate: nextStart,
        batchCount: 3,
        targetLikes: 10,
        targetRetweets: 5,
        targetQuotes: 2
      });

      res.json({
        ok: true,
        message: `🎉 7名AI合議制により次回枠【${launchRes.scheduledCount}投稿】の予約投稿を生成・キューへ補充しました！`,
        scheduledCount: launchRes.scheduledCount
      });
    } catch (err) {
      res.json({ ok: false, error: err.message });
    }
  });

  // 2-D. 🗑️ 予約投稿のキャンセル・削除API
  app.post('/api/autopilot/jobs/:jobId/cancel', async (req, res) => {
    try {
      const { jobId } = req.params;
      const jobRef = db.collection('autopilot_jobs').doc(jobId);
      const snap = await jobRef.get();
      if (!snap.exists) return res.json({ ok: false, error: 'ジョブが見つかりません' });
      const job = snap.data();
      if (job.status === 'posted') {
        return res.json({ ok: false, error: '既にX上に投稿済みのポストはキャンセルできません。' });
      }
      await jobRef.delete();
      res.json({ ok: true, message: '予約投稿をキャンセル・削除しました。' });
    } catch (err) {
      res.json({ ok: false, error: err.message });
    }
  });

  // 5. サテライトプール待機状況
  app.get('/api/hybrid/pool-stats', async (req, res) => {
    try {
      const clearedSnap = await db.collection('accounts').where('status', '==', 'cleared').get();
      const farmingSnap = await db.collection('accounts').where('status', '==', 'farming').get();

      res.json({
        ok: true,
        satellitePool: {
          cleared: clearedSnap.size,
          farming: farmingSnap.size,
          totalReadySatellites: clearedSnap.size + farmingSnap.size
        }
      });
    } catch (err) {
      res.json({ ok: false, error: err.message });
    }
  });


  // ⏸/▶ 自律運用のスタート/ストップ（一時停止・再開）トグルAPI
  app.post('/api/autopilot/toggle-pause', async (req, res) => {
    try {
      const { userId = 'default_user', lang = 'ja' } = req.body || {};
      const userObj = await resolveUserDoc(userId);
      if (!userObj) {
        return res.json({ ok: false, error: 'User not found' });
      }

      const isPaused = Boolean(userObj.data.autopilotPaused);
      const nextPaused = !isPaused;

      await userObj.doc.ref.update({
        autopilotPaused: nextPaused,
        updatedAt: new Date()
      });

      res.json({
        ok: true,
        isPaused: nextPaused,
        message: nextPaused
          ? (lang === 'en' ? '⏸ Autonomous marketing has been paused.' : '⏸ 自律運用を一時停止しました。予約投稿の配信は保留されます。')
          : (lang === 'en' ? '▶ Autonomous marketing resumed!' : '▶ 自律運用を再開しました！スケジュール通りに自律投稿が行われます。')
      });
    } catch (e) {
      res.json({ ok: false, error: e.message });
    }
  });

  // 2-C. 🤖 手動で次回枠の予約投稿をAI合議生成・補充するAPI
  app.post('/api/autopilot/replenish', async (req, res) => {
    try {
      const { userId = 'default_user' } = req.body || {};
      const userObj = await resolveUserDoc(userId);
      if (!userObj || !userObj.data.targetUrl || !userObj.data.xOfficialCredentials) {
        return res.json({ ok: false, error: '先に【ステップ1: 公式API接続】と【ステップ2: ターゲットURL設定】を完了してください。' });
      }

      const jobsSnap = await db.collection('autopilot_jobs')
        .where('userId', '==', userObj.userId)
