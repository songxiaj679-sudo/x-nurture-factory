            <button type="button" class="lang-opt" data-lang="zh-CN" data-label="🌐 ZH — 简体中文" onclick="selectSiteLanguage('zh-CN', this)"><span>🇨🇳 简体中文 (Chinese)</span><span>CN</span></button>
